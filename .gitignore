# Universal gitignore
# Only patterns that are never source across OS / editor / language.
# Not ignored: lockfiles, AGENTS.md , .cursor/, shared .vscode config.

# --- OS ---
.DS_Store
.localized
._*
.AppleDouble
.LSOverride
__MACOSX/
.Spotlight-V100
.Trashes
.TemporaryItems
.fseventsd
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*
nohup.out

# --- Editors ---
*.swp
*.swo
*.swn
*.sw?
.idea/
*.iml
*.ipr
*.iws
.history/
*.vsix
*.suo
*.ntvs*
*.njsproj
*.user
*.userosscache
.vscode-test
.vscode/*.log

# --- Secrets ---
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
*.local.md
*.local.json
AGENTS.local.md
*.pem
*.p8
*.p12
*.pfx
*.key
*.jks
*.keystore
*.mobileprovision
local.properties
key.properties
secrets.properties
keystore.properties
credentials.json
service-account*.json
google-services.json
GoogleService-Info.plist
agconnect-services.json
.dev.vars

# --- Dependencies ---
node_modules/
oh_modules/
.ohpm/
jspm_packages/
bower_components/
vendor/
.venv/
venv/
.python-version.bak
.pub-cache/
.pub/
Pods/
.gradle/
.pnpm-store/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
.yarn-integrity

# --- Build / cache ---
dist/
dist-ssr/
build/
build/Release
out/
output/
outputs/
tmp/
temp/
.cache/
.parcel-cache/
.turbo/
.vite/
.next/
.nuxt/
.output/
.astro/
.vercel/
.netlify/
.docusaurus/
.serverless/
.wrangler/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.hvigor/
.cxx/
.preview/
.externalNativeBuild/
*.tsbuildinfo
*.class
*.pyc
*.pyo
*.egg-info/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.ipynb_checkpoints/
.eslintcache
.stylelintcache
.phpunit.result.cache
.phpunit.cache
.npm
.node_repl_history
target/
*.rs.bk
DerivedData/
xcuserdata/
*.xcuserstate
*.apk
*.aab
*.ap_
*.ipa
*.hap
*.exe
*.dll
*.dmg
*.app/

# --- Logs / tests / coverage ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
coverage/
*.lcov
.nyc_output/
lib-cov
.playwright-cli/
.playwright-mcp/
playwright-report/
playwright/.cache/
test-results/
blob-report/
*.pid
*.pid.lock
pids/

# --- Local agent / tooling state ---
STATUS.md
.agent-state/
.agent-status/
.playwright-*
.kilo/
.kiro/cache/
.dsh-vision-router/
.codex_tmp/
.council/
.council-tmp-*/
.council-verify/
.local/
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# --- Repo-specific ---
# social preview: only the generated PNGs ship, not the template or its notes.
docs/social-preview/*
!docs/social-preview/*.png
